{
  "name": "wakenswag",
  "private": true,
  "sideEffects": false,
  "version": "2026.10.3",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "hydrogen skills check --mode=warn && vite dev",
    "preview": "npm run build && vite preview",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "typecheck": "react-router typegen && tsc --noEmit && hydrogen gql check --fail-on-warn",
    "codegen": "hydrogen gql check --fail-on-warn && react-router typegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:serve": "vite dev --config vite.e2e.config.ts --port 4173",
    "format:check": "prettier --check app tests *.md *.ts *.js package.json tsconfig.json .github/workflows",
    "dev:https": "hydrogen skills check --mode=warn && vite dev",
    "deploy": "npm run build && shopify hydrogen deploy --assets-dir dist/client --worker-dir dist/server",
    "test:e2e:build": "react-router build --config vite.e2e.config.ts",
    "test:e2e:preview": "vite preview --config vite.e2e.config.ts --port 4173",
    "test:load": "node tests/load/storefront.mjs"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@shopify/hydrogen": "2026.10.3",
    "graphql": "^16.13.2",
    "isbot": "^5.1.36",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.18.5",
    "sanitize-html": "^2.18.1",
    "tailwindcss": "^4.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "7.18.5",
    "@react-router/fs-routes": "7.18.5",
    "@shopify/cli": "4.8.1",
    "@shopify/mini-oxygen": "4.2.3",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@tailwindcss/vite": "^4.1.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.12",
    "@types/node": "^22",
    "gql.tada": "^1.9.2"
  },
  "engines": {
    "node": "^22.12 || ^24"
  },
  "browserslist": [
    "defaults"
  ]
}
